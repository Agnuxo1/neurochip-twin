{{ r6b_dosecompass_anchored.json : diagnostics.composite_B3_by_reference_activity.neurotrajectory.fixed_logspaced.reference_inactive | .3f }} to
{{ r6b_dosecompass_anchored.json : diagnostics.composite_B3_by_reference_activity.neurotrajectory.dosecompass_anchored.reference_inactive | .3f }}.
