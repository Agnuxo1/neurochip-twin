{{ r5_selectivity.json : auroc_cytotoxic_potency_only | .3f }} \ci{ {{ r5_selectivity.json : auroc_cyto_ci95.0 | .3f }} }{ {{ r5_selectivity.json : auroc_cyto_ci95.1 | .3f }} }
